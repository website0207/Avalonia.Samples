<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameDevToolkit.ViewModels"
        xmlns:views="using:GameDevToolkit.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="GameDevToolkit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameDevToolkit - 游戏开发工具箱">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="0,0,8,8" Padding="20,15,20,20" Margin="20,0,20,10">
            <StackPanel Spacing="5">
                <TextBlock Text="🎮 GameDevToolkit"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="专业的游戏开发工具箱 - 提升开发效率的必备工具"
                           FontSize="12" Opacity="0.8"
                           Foreground="White" />
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <TabControl Classes="main-navigation" SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Perforce 工具标签页 -->
                <TabItem Header="🔧 Perforce 工具">
                    <views:PerforceToolsView DataContext="{Binding PerforceToolsViewModel}" />
                </TabItem>

                <!-- 文件工具标签页 (预留) -->
                <TabItem Header="📁 文件工具">
                    <Grid Background="#F8FAFC">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="文件工具"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="更多文件相关工具即将推出..."
                                       FontSize="14" Opacity="0.6"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 项目工具标签页 (预留) -->
                <TabItem Header="🏗️ 项目工具">
                    <Grid Background="#F8FAFC">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                            <TextBlock Text="🏗️" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="项目工具"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="项目管理相关工具即将推出..."
                                       FontSize="14" Opacity="0.6"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 设置标签页 -->
                <TabItem Header="⚙️ 设置">
                    <Grid Background="#F8FAFC">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                            <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="应用设置"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="全局设置和配置选项即将推出..."
                                       FontSize="14" Opacity="0.6"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Spacing="10" Margin="0,20,0,0">
                                <TextBlock Text="版本信息" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="GameDevToolkit v1.0.0"
                                           FontSize="12" Opacity="0.7"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="基于 Avalonia UI 构建"
                                           FontSize="12" Opacity="0.7"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>

    <!-- 样式定义 -->
    <Window.Styles>
        <Style Selector="TabControl.main-navigation">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TabControl.main-navigation TabItem">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="20,15" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>

        <Style Selector="TabControl.main-navigation TabItem:pointerover">
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>

        <Style Selector="TabControl.main-navigation TabItem:selected">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
        </Style>

        <Style Selector="TabControl.main-navigation TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Margin" Value="0,0,0,-1" />
        </Style>
    </Window.Styles>
</Window>